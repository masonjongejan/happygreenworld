---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const countries = await getCollection('countries');

const byRegion: Record<string, typeof countries> = {};
for (const country of countries) {
  const region = country.data.region;
  if (!byRegion[region]) byRegion[region] = [];
  byRegion[region].push(country);
}

const regionOrder = ['Africa', 'Asia', 'Middle East', 'Europe', 'Oceania', 'Americas'];
const sortedRegions = regionOrder.filter(r => byRegion[r]);
---

<PageLayout
  title="Impact & Countries"
  description="Happy Green World works with partner organisations in 12+ countries across Africa, Asia, Europe, and Oceania to deliver environmental education to thousands of children."
>
  <!-- Hero -->
  <section style="background: linear-gradient(135deg, #2D6A4F 0%, #1e4d38 100%); padding: 5rem 1.5rem; color: #fff;">
    <div style="max-width: 800px; margin: 0 auto; text-align: center;">
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
        <a href="/" style="font-size: 0.875rem; color: rgba(255,255,255,0.65); text-decoration: none;">Home</a>
        <span style="font-size: 0.875rem; color: rgba(255,255,255,0.4); margin: 0 0.5rem;">/</span>
        <span style="font-size: 0.875rem; color: rgba(255,255,255,0.9);">Impact & Countries</span>
      </nav>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; color: #fff; margin: 0 0 1rem;">
        A global impact, delivered locally
      </h1>
      <p style="font-size: 1.125rem; color: rgba(255,255,255,0.8); line-height: 1.7; margin: 0; max-width: 600px; margin-left: auto; margin-right: auto;">
        We don't parachute in. We partner with established local organisations who understand their communities — and we give them world-class educational materials to deliver.
      </p>
    </div>
  </section>

  <!-- Stats -->
  <section style="padding: 4rem 1.5rem; background: var(--color-surface); border-bottom: 1px solid var(--color-border);">
    <div style="max-width: 900px; margin: 0 auto;">
      <ul style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; text-align: center;" class="stats-grid">
        {[
          { value: '12+', label: 'Countries', sub: 'across 4 continents' },
          { value: '10+', label: 'Partner orgs', sub: 'established local partners' },
          { value: '3', label: 'Programmes', sub: 'waste, water, energy' },
          { value: '2013', label: 'Operating since', sub: 'over a decade of impact' },
        ].map(({ value, label, sub }) => (
          <li style="padding: 1.5rem; background: var(--color-bg); border-radius: 14px; border: 1px solid var(--color-border);">
            <div style="font-family: var(--font-display); font-size: 2.25rem; font-weight: 700; color: var(--color-primary); margin-bottom: 0.25rem;">{value}</div>
            <div style="font-size: 0.9375rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.25rem;">{label}</div>
            <div style="font-size: 0.8125rem; color: var(--color-text-muted);">{sub}</div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- World map -->
  <section style="padding: 4rem 1.5rem; background: var(--color-bg);">
    <div style="max-width: 1000px; margin: 0 auto; text-align: center;">
      <h2 style="font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text); margin: 0 0 2rem;">
        Where we work
      </h2>
      <div style="border-radius: 16px; overflow: hidden; border: 1px solid var(--color-border);">
        <img
          src="/images/countries-world-map.jpg"
          alt="World map showing countries where Happy Green World operates: Cameroon, Ghana, Congo, Egypt, Ethiopia, Indonesia, Molluccas, Senegal, Sierra Leone, Thailand, Netherlands, Australia"
          style="width: 100%; height: auto; display: block;"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Country grid -->
  <section style="padding: 5rem 1.5rem; background: var(--color-surface); border-top: 1px solid var(--color-border);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <h2 style="font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text); margin: 0 0 0.75rem;">
        Our partners, by region
      </h2>
      <p style="font-size: 1rem; color: var(--color-text-muted); margin: 0 0 3rem; line-height: 1.65;">
        Each of these organisations brings Happy Green World's educational materials to children in their community.
      </p>

      {sortedRegions.map((region) => (
        <div style="margin-bottom: 3rem;">
          <h3 style="
            font-family: var(--font-body);
            font-size: 0.8125rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--color-text-muted);
            margin: 0 0 1.25rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid var(--color-border);
          ">
            {region}
          </h3>
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;" class="country-grid">
            {byRegion[region].map((country) => (
              <article style="
                background: var(--color-bg);
                border: 1px solid var(--color-border);
                border-radius: 12px;
                padding: 1.25rem 1.5rem;
              ">
                <h4 style="font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.375rem;">
                  {country.data.name}
                </h4>
                <p style="font-size: 0.875rem; color: var(--color-primary); font-weight: 500; margin: 0;">
                  {country.data.partner}
                </p>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- How partnership works -->
  <section style="padding: 5rem 1.5rem; background: var(--color-bg); border-top: 1px solid var(--color-border);">
    <div style="max-width: 900px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 3.5rem;">
        <h2 style="font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text); margin: 0 0 0.875rem;">
          How partnership works
        </h2>
        <p style="font-size: 1rem; color: var(--color-text-muted); line-height: 1.65; max-width: 540px; margin: 0 auto;">
          Our model is simple. We bring the materials and expertise. You bring the local knowledge and distribution network.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-bottom: 3rem;" class="steps-grid">
        {[
          {
            num: '01',
            title: 'Tell us about your context',
            desc: 'Fill in our short inquiry form. Tell us about your organisation, your country, and the children you want to reach.',
          },
          {
            num: '02',
            title: 'We have a conversation',
            desc: 'Our team responds within 5 business days to explore how we can adapt our materials for your specific community.',
          },
          {
            num: '03',
            title: 'Launch together',
            desc: 'We localise the materials. You handle distribution. Together, we reach more children with the education they deserve.',
          },
        ].map(({ num, title, desc }) => (
          <div style="text-align: center; padding: 2rem; background: var(--color-surface); border-radius: 16px; border: 1px solid var(--color-border);">
            <div style="font-family: var(--font-display); font-size: 2.5rem; font-weight: 700; color: rgba(45, 106, 79, 0.15); margin-bottom: 0.75rem; line-height: 1;">
              {num}
            </div>
            <h3 style="font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.625rem;">
              {title}
            </h3>
            <p style="font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.65; margin: 0;">
              {desc}
            </p>
          </div>
        ))}
      </div>

      <div style="text-align: center;">
        <a
          href="/partner-with-us"
          style="
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.875rem 2rem;
            background: var(--color-accent);
            color: var(--color-text);
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            border-radius: 10px;
          "
        >
          Start the Conversation →
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  @media (max-width: 768px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr) !important; }
    .country-grid { grid-template-columns: 1fr 1fr !important; }
    .steps-grid { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 480px) {
    .country-grid { grid-template-columns: 1fr !important; }
    .stats-grid { grid-template-columns: repeat(2, 1fr) !important; }
  }
</style>
