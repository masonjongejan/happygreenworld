---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Contact Us"
  description="Get in touch with Happy Green World Foundation. Email us at info@happygreenworld.org or use our contact form."
>
  <section style="background: linear-gradient(135deg, #2D6A4F 0%, #1e4d38 100%); padding: 5rem 1.5rem; color: #fff;">
    <div style="max-width: 800px; margin: 0 auto; text-align: center;">
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
        <a href="/" style="font-size: 0.875rem; color: rgba(255,255,255,0.65); text-decoration: none;">Home</a>
        <span style="font-size: 0.875rem; color: rgba(255,255,255,0.4); margin: 0 0.5rem;">/</span>
        <span style="font-size: 0.875rem; color: rgba(255,255,255,0.9);">Contact</span>
      </nav>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; color: #fff; margin: 0 0 1rem;">
        Get in Touch
      </h1>
      <p style="font-size: 1.125rem; color: rgba(255,255,255,0.8); line-height: 1.7; margin: 0;">
        We'd love to hear from you. Use the form below or reach us directly at <a href="mailto:info@happygreenworld.org" style="color: #FFD166; font-weight: 600;">info@happygreenworld.org</a>.
      </p>
    </div>
  </section>

  <section style="padding: 5rem 1.5rem; background: var(--color-bg);">
    <div style="max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: 1fr 340px; gap: 4rem; align-items: start;" class="contact-grid">
      <!-- Form -->
      <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 20px; padding: 2.5rem;">
        <h2 style="font-family: var(--font-display); font-size: 1.375rem; font-weight: 600; color: var(--color-text); margin: 0 0 1.75rem;">
          Send us a message
        </h2>

        <form
          name="contact"
          method="POST"
          data-netlify="true"
          action="/thank-you"
          style="display: flex; flex-direction: column; gap: 1.25rem;"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p style="display: none;"><label>Don't fill this out: <input name="bot-field" /></label></p>

          <div>
            <label for="contact-name" style="display: block; font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
              Your Name <span style="color: #c0392b;">*</span>
            </label>
            <input
              type="text" id="contact-name" name="name" required autocomplete="name"
              style="width: 100%; padding: 0.75rem 1rem; border: 1.5px solid var(--color-border); border-radius: 10px; font-family: var(--font-body); font-size: 1rem; color: var(--color-text); background: var(--color-bg); box-sizing: border-box;"
            />
          </div>

          <div>
            <label for="contact-email" style="display: block; font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
              Email Address <span style="color: #c0392b;">*</span>
            </label>
            <input
              type="email" id="contact-email" name="email" required autocomplete="email"
              style="width: 100%; padding: 0.75rem 1rem; border: 1.5px solid var(--color-border); border-radius: 10px; font-family: var(--font-body); font-size: 1rem; color: var(--color-text); background: var(--color-bg); box-sizing: border-box;"
            />
          </div>

          <div>
            <label for="contact-org" style="display: block; font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
              Organisation
            </label>
            <input
              type="text" id="contact-org" name="organisation" autocomplete="organization"
              style="width: 100%; padding: 0.75rem 1rem; border: 1.5px solid var(--color-border); border-radius: 10px; font-family: var(--font-body); font-size: 1rem; color: var(--color-text); background: var(--color-bg); box-sizing: border-box;"
            />
          </div>

          <div>
            <label for="contact-message" style="display: block; font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
              Message <span style="color: #c0392b;">*</span>
            </label>
            <textarea
              id="contact-message" name="message" required rows="5"
              style="width: 100%; padding: 0.875rem 1rem; border: 1.5px solid var(--color-border); border-radius: 10px; font-family: var(--font-body); font-size: 1rem; color: var(--color-text); background: var(--color-bg); box-sizing: border-box; resize: vertical; min-height: 120px;"
            ></textarea>
          </div>

          <button
            type="submit"
            style="padding: 0.875rem 1.5rem; background: var(--color-primary); color: #fff; font-family: var(--font-body); font-size: 1rem; font-weight: 700; border: none; border-radius: 10px; cursor: pointer; width: 100%;"
          >
            Send Message
          </button>
        </form>
      </div>

      <!-- Sidebar -->
      <aside style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 16px; padding: 1.5rem;">
          <h3 style="font-family: var(--font-display); font-size: 1rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.875rem;">
            Direct contact
          </h3>
          <a
            href="mailto:info@happygreenworld.org"
            style="font-size: 0.9375rem; color: var(--color-primary); font-weight: 500; text-decoration: none; display: block; word-break: break-all;"
          >
            info@happygreenworld.org
          </a>
        </div>

        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 16px; padding: 1.5rem;">
          <h3 style="font-family: var(--font-display); font-size: 1rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.875rem;">
            Follow us
          </h3>
          <div style="display: flex; flex-direction: column; gap: 0.625rem;">
            <a
              href="https://www.facebook.com/happygreenworld"
              target="_blank"
              rel="noopener noreferrer"
              style="display: flex; align-items: center; gap: 0.625rem; font-size: 0.9375rem; color: var(--color-text); text-decoration: none;"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#1877F2" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              Facebook
            </a>
            <a
              href="https://www.instagram.com/happygreenworldorg/"
              target="_blank"
              rel="noopener noreferrer"
              style="display: flex; align-items: center; gap: 0.625rem; font-size: 0.9375rem; color: var(--color-text); text-decoration: none;"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="url(#ig)" aria-hidden="true"><defs><linearGradient id="ig" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#f09433"/><stop offset="25%" stop-color="#e6683c"/><stop offset="50%" stop-color="#dc2743"/><stop offset="75%" stop-color="#cc2366"/><stop offset="100%" stop-color="#bc1888"/></linearGradient></defs><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              @happygreenworldorg
            </a>
          </div>
        </div>

        <div style="background: rgba(244, 162, 97, 0.1); border: 1px solid rgba(244, 162, 97, 0.3); border-radius: 16px; padding: 1.5rem;">
          <h3 style="font-family: var(--font-display); font-size: 1rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.625rem;">
            Enquiring as an organisation?
          </h3>
          <p style="font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.6; margin: 0 0 0.875rem;">
            If you represent a school, NGO, foundation, or corporate programme, use our dedicated inquiry page for a faster, more tailored response.
          </p>
          <a
            href="/partner-with-us"
            style="font-size: 0.875rem; font-weight: 700; color: var(--color-primary); text-decoration: underline; text-underline-offset: 3px;"
          >
            Go to Partner With Us →
          </a>
        </div>
      </aside>
    </div>
  </section>
</PageLayout>

<style>
  input:focus, textarea:focus { outline: none; border-color: var(--color-primary) !important; box-shadow: 0 0 0 3px rgba(45, 106, 79, 0.15); }
  @media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr !important; } }
</style>
