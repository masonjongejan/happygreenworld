---
import PageLayout from '../../layouts/PageLayout.astro';

const programmes = [
  {
    slug: 'waste',
    title: 'Waste & Recycling',
    tagline: 'Teaching children to reduce, reuse, and recycle',
    description: 'Our environmental programmes teach sustainable behaviour towards waste, water and energy. All resources are customised and localised for children to relate better and act on the lessons learned.',
    ageRange: 'Ages 6–16',
    color: '#52B788',
    textColor: '#2D6A4F',
    bgColor: 'rgba(82, 183, 136, 0.12)',
    languages: ['English', 'French', 'Bahasa Indonesia', 'Spanish', 'Vietnamese', 'Khmer', 'Swahili', 'Arabic', 'Dutch', 'Thai'],
    materials: [
      {
        title: 'Activity Guide for Teachers',
        description: 'Contains 35 interactive activities discussing the concept of reduce, reuse, and recycle waste through awareness, thinking, and doing activities.',
        img: 'https://image.isu.pub/241107154947-bf1e5f463bf1098e1ff2a7f9b092b2fe/jpg/page_1_thumb_large.jpg',
        docId: '031024aghappygreentanzaniaengels',
      },
      {
        title: 'Student Book',
        description: 'Explains the origin of materials such as plastic, green waste, glass, and paper. Discusses the problems and effects on nature, decomposition times, and active solutions. Full-colour illustrations show a city gradually changing from polluted to green and healthy.',
        img: 'https://image.isu.pub/241107155913-594b6739615cc3a01953ad97b7ad48dc/jpg/page_1_thumb_large.jpg',
        docId: 'issuuhgtsb',
      },
      {
        title: 'Recycling Game',
        description: 'Based on snakes and ladders, where good or bad behaviour towards waste is rewarded or penalised. Children learn by playing and revisit the environmental lessons and actions multiple times.',
        img: 'https://image.isu.pub/241107161605-c4c8aa09c23c215f5d0fa6056cf4fe08/jpg/page_1_thumb_large.jpg',
        docId: '031024happygreentanzaniabg',
      },
    ],
  },
  {
    slug: 'water',
    title: 'Water & Conservation',
    tagline: 'Teaching children why water is precious and how to protect it',
    description: 'Children learn why water is precious, how drinking water is treated and how to conserve and protect it. All materials are adapted for the local context.',
    ageRange: 'Ages 6–16',
    color: '#74C0FC',
    textColor: '#1864ab',
    bgColor: 'rgba(116, 192, 252, 0.15)',
    languages: ['English', 'Dutch'],
    materials: [
      {
        title: 'Activity Guide for Teachers',
        description: 'Interactive activities that guide children through the water cycle, water sources, and practical actions to conserve water in their daily lives.',
        img: 'https://image.isu.pub/241107154947-bf1e5f463bf1098e1ff2a7f9b092b2fe/jpg/page_1_thumb_large.jpg',
        docId: '031024aghappygreentanzaniaengels',
      },
      {
        title: 'Student Book',
        description: 'A full-colour book explaining where drinking water comes from, how it is treated, and what children can do to protect water resources in their community.',
        img: 'https://image.isu.pub/241113152958-7312cdd7f4c51bc3673e825cec5ad743/jpg/page_1_thumb_large.jpg',
        docId: '030924sbvietnam',
      },
      {
        title: 'Water Game',
        description: 'A playful board game where children practise water-saving decisions, reinforcing the lessons from the activity guide and student book through play.',
        img: 'https://image.isu.pub/200619055200-cf0bd72947dcc96efe96ef8f4b72a7df/jpg/page_1_thumb_large.jpg',
        docId: '19.6.2020_hgw_water_game.issuu',
      },
    ],
  },
  {
    slug: 'energy',
    title: 'Energy & Climate',
    tagline: 'Teaching children about fossil fuels, renewables, and sustainable choices',
    description: 'Children learn about fossil fuels and renewables and how and why to make sustainable choices with regards to energy. Illustrations and country editions are currently being developed.',
    ageRange: 'Ages 6–16',
    color: '#FFD166',
    textColor: '#8a6200',
    bgColor: 'rgba(255, 209, 102, 0.2)',
    languages: ['English'],
    materials: [
      {
        title: 'Activity Guide for Teachers',
        description: 'Interactive activities covering energy sources, the impact of fossil fuels, and practical steps children and families can take to reduce energy use.',
        img: null,
      },
      {
        title: 'Student Book',
        description: 'A full-colour guide to energy — how it is produced, what fossil fuels are, and why renewables matter for our planet\'s future.',
        img: null,
      },
      {
        title: 'Energy Game',
        description: 'A board game where children make energy choices, learning through play which decisions help or harm the environment.',
        img: null,
      },
    ],
  },
];
---

<PageLayout
  title="Our Programmes"
  description="Happy Green World offers three core environmental education programmes for children aged 6–16: Waste & Recycling, Water & Conservation, and Energy & Climate — each localised for the communities where they are taught."
>
  <!-- Hero -->
  <section style="background: linear-gradient(135deg, #2D6A4F 0%, #1e4d38 100%); padding: 5rem 1.5rem; color: #fff;">
    <div style="max-width: 800px; margin: 0 auto; text-align: center;">
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
        <a href="/" style="font-size: 0.875rem; color: rgba(255,255,255,0.65); text-decoration: none;">Home</a>
        <span style="font-size: 0.875rem; color: rgba(255,255,255,0.4); margin: 0 0.5rem;">/</span>
        <span style="font-size: 0.875rem; color: rgba(255,255,255,0.9);">Programmes</span>
      </nav>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; color: #fff; margin: 0 0 1rem;">
        Our Environmental Programmes
      </h1>
      <p style="font-size: 1.125rem; color: rgba(255,255,255,0.8); line-height: 1.7; margin: 0; max-width: 640px; margin-left: auto; margin-right: auto;">
        Our environmental programmes teach sustainable behaviour towards waste, water and energy. All resources are customised and localised for children to relate better and act on the lessons learned.
      </p>
    </div>
  </section>

  <!-- Programmes -->
  <section style="padding: 5rem 1.5rem; background: var(--color-bg);">
    <div style="max-width: 1100px; margin: 0 auto; display: grid; gap: 4rem;">
      {programmes.map((prog) => (
        <article style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 20px; overflow: hidden;">
          <!-- Programme header -->
          <div style={`background: ${prog.bgColor}; border-bottom: 1px solid var(--color-border); padding: 2rem 2.5rem; display: flex; align-items: flex-start; gap: 1.5rem;`} class="prog-header">
            <div style={`width: 64px; height: 64px; border-radius: 14px; background: rgba(255,255,255,0.7); color: ${prog.color}; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1.5px solid rgba(255,255,255,0.8);`} set:html={
              prog.slug === 'waste'
                ? `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="3,6 5,6 21,6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>`
                : prog.slug === 'water'
                ? `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6 9 4 13 4 16a8 8 0 0 0 16 0c0-3-2-7-8-14z"/></svg>`
                : `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>`
            } />
            <div style="flex: 1;">
              <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.5rem;">
                <h2 style="font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; color: var(--color-text); margin: 0;">
                  {prog.title}
                </h2>
                <span style={`display: inline-block; padding: 0.25rem 0.75rem; background: rgba(255,255,255,0.65); color: ${prog.textColor}; font-size: 0.8125rem; font-weight: 600; border-radius: 99px; border: 1px solid rgba(255,255,255,0.5);`}>
                  {prog.ageRange}
                </span>
              </div>
              <p style="font-size: 1rem; color: var(--color-text-muted); line-height: 1.65; margin: 0; max-width: 640px;">
                {prog.description}
              </p>
            </div>
          </div>

          <!-- Materials grid -->
          <div style="padding: 2.5rem;" class="prog-body">
            {prog.slug === 'energy' ? (
              <div style={`border-radius: 14px; padding: 3rem 2rem; background: ${prog.bgColor}; border: 2px dashed rgba(216,160,32,0.35); text-align: center;`}>
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke={prog.textColor} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin: 0 auto 1rem; display: block; opacity: 0.6;">
                  <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                </svg>
                <p style={`font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; color: ${prog.textColor}; margin: 0 0 0.5rem;`}>
                  Programme coming soon
                </p>
                <p style="font-size: 0.9375rem; color: var(--color-text-muted); margin: 0; line-height: 1.6; max-width: 480px; margin-left: auto; margin-right: auto;">
                  The Energy & Climate programme — including the activity guide, student book, and game — is currently in development. Get in touch if you'd like to be the first to know when it launches.
                </p>
              </div>
            ) : (
              <>
            <h3 style="font-family: var(--font-display); font-size: 0.875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-text-muted); margin: 0 0 1.5rem;">
              Programme Materials
            </h3>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;" class="materials-grid">
              {prog.materials.map((mat) => (
                <div style="background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 14px; overflow: hidden;">
                  {mat.img ? (
                    mat.docId ? (
                      <a
                        href={`https://issuu.com/happygreenworld/docs/${mat.docId}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        style="display: block;"
                      >
                        <img
                          src={mat.img}
                          alt={mat.title}
                          loading="lazy"
                          style="width: 100%; height: 200px; object-fit: cover; display: block;"
                        />
                      </a>
                    ) : (
                      <img
                        src={mat.img}
                        alt={mat.title}
                        loading="lazy"
                        style="width: 100%; height: 200px; object-fit: cover; display: block;"
                      />
                    )
                  ) : null}
                  <div style="padding: 1.125rem 1rem 1.25rem;">
                    <h4 style="font-family: var(--font-display); font-size: 0.9375rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.5rem;">
                      {mat.title}
                    </h4>
                    <p style="font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.6; margin: 0;">
                      {mat.description}
                    </p>
                  </div>
                </div>
              ))}
            </div>

            <!-- Languages -->
            <div style="margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap;">
              <span style="font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted); flex-shrink: 0;">
                Available in {prog.languages.length} {prog.languages.length === 1 ? 'language' : 'languages'}:
              </span>
              <span style="font-size: 0.9375rem; color: var(--color-text);">
                {prog.languages.join(' · ')}
              </span>
            </div>
            </>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section style="padding: 4rem 1.5rem; background: var(--color-surface); border-top: 1px solid var(--color-border); text-align: center;">
    <div style="max-width: 600px; margin: 0 auto;">
      <h2 style="font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 1.875rem); color: var(--color-text); margin: 0 0 0.875rem;">
        Contact us to bring environmental education to your community!
      </h2>
      <p style="font-size: 1rem; color: var(--color-text-muted); line-height: 1.65; margin: 0 0 1.5rem;">
        We work with schools, NGOs, and organisations worldwide to localise and distribute our materials.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a
          href="/partner-with-us"
          style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.75rem; background: var(--color-accent); color: var(--color-text); font-size: 1rem; font-weight: 700; text-decoration: none; border-radius: 10px;"
        >
          Partner With Us →
        </a>
        <a
          href="/resources"
          style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.75rem; background: transparent; color: var(--color-primary); font-size: 1rem; font-weight: 600; text-decoration: none; border-radius: 10px; border: 2px solid var(--color-primary);"
        >
          Browse Educational Resources →
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  @media (max-width: 900px) {
    .prog-header { flex-direction: column !important; }
    .materials-grid { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 600px) {
    .prog-body { padding: 1.5rem !important; }
  }
</style>
