---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const programmes = (await getCollection('programmes')).sort((a, b) => a.data.order - b.data.order);

const colorMap: Record<string, { text: string; bg: string }> = {
  '#52B788': { text: '#2D6A4F', bg: 'rgba(82, 183, 136, 0.12)' },
  '#74C0FC': { text: '#1864ab', bg: 'rgba(116, 192, 252, 0.15)' },
  '#FFD166': { text: '#8a6200', bg: 'rgba(255, 209, 102, 0.2)' },
};

const programmeCovers: Record<string, { img: string; label: string; docId: string }[]> = {
  waste: [
    { img: 'https://image.isu.pub/241107155913-594b6739615cc3a01953ad97b7ad48dc/jpg/page_1_thumb_large.jpg', label: 'Tanzania Student Book', docId: 'issuuhgtsb' },
    { img: 'https://image.isu.pub/241107154947-bf1e5f463bf1098e1ff2a7f9b092b2fe/jpg/page_1_thumb_large.jpg', label: 'Tanzania Activity Guide', docId: '031024aghappygreentanzaniaengels' },
    { img: 'https://image.isu.pub/241107161605-c4c8aa09c23c215f5d0fa6056cf4fe08/jpg/page_1_thumb_large.jpg', label: 'Tanzania Board Game', docId: '031024happygreentanzaniabg' },
    { img: 'https://image.isu.pub/240326195802-b2a12b44ef362b23b1684ca814e2445d/jpg/page_1_thumb_large.jpg', label: 'Philippines Waste Game', docId: '200224boardgamehgp' },
  ],
  water: [
    { img: 'https://image.isu.pub/241107155913-594b6739615cc3a01953ad97b7ad48dc/jpg/page_1_thumb_large.jpg', label: 'Tanzania Student Book', docId: 'issuuhgtsb' },
    { img: 'https://image.isu.pub/241107154947-bf1e5f463bf1098e1ff2a7f9b092b2fe/jpg/page_1_thumb_large.jpg', label: 'Tanzania Activity Guide', docId: '031024aghappygreentanzaniaengels' },
    { img: 'https://image.isu.pub/200619055200-cf0bd72947dcc96efe96ef8f4b72a7df/jpg/page_1_thumb_large.jpg', label: 'HGW Water Game', docId: '19.6.2020_hgw_water_game.issuu' },
    { img: 'https://image.isu.pub/241113152958-7312cdd7f4c51bc3673e825cec5ad743/jpg/page_1_thumb_large.jpg', label: 'Vietnam Student Book', docId: '030924sbvietnam' },
  ],
  energy: [
    { img: 'https://image.isu.pub/240326202259-c30fc83bec9800a45efb8f4ddfd41a74/jpg/page_1_thumb_large.jpg', label: 'Philippines Student Book', docId: '200224sbhgp' },
    { img: 'https://image.isu.pub/240326200958-cfe841a37b46d76d96bde4cae985be1a/jpg/page_1_thumb_large.jpg', label: 'Philippines Activity Guide', docId: '200224hgpag' },
    { img: 'https://image.isu.pub/241113111824-69ec82d9dce708d9346d2fac78b973bd/jpg/page_1_thumb_large.jpg', label: 'Vietnam Activity Guide', docId: 'agvietnam30082024' },
    { img: 'https://image.isu.pub/230213155024-a3104178e983ddea46e0da56fa04ab2b/jpg/page_1_thumb_large.jpg', label: 'Afrique Student Book', docId: '100821afriquepropreetvert' },
  ],
};
---

<PageLayout
  title="Our Programmes"
  description="Happy Green World offers three core environmental education programmes for children aged 6–16: Waste & Recycling, Water & Conservation, and Energy & Climate — each localised for the communities where they are taught."
>
  <!-- Hero -->
  <section style="background: linear-gradient(135deg, #2D6A4F 0%, #1e4d38 100%); padding: 5rem 1.5rem; color: #fff;">
    <div style="max-width: 800px; margin: 0 auto; text-align: center;">
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
        <a href="/" style="font-size: 0.875rem; color: rgba(255,255,255,0.65); text-decoration: none;">Home</a>
        <span style="font-size: 0.875rem; color: rgba(255,255,255,0.4); margin: 0 0.5rem;">/</span>
        <span style="font-size: 0.875rem; color: rgba(255,255,255,0.9);">Programmes</span>
      </nav>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; color: #fff; margin: 0 0 1rem;">
        Our Programmes
      </h1>
      <p style="font-size: 1.125rem; color: rgba(255,255,255,0.8); line-height: 1.7; margin: 0; max-width: 600px; margin-left: auto; margin-right: auto;">
        Three core curriculum areas, each designed to be meaningful in the local context where it is taught — with illustrations, activities, and examples drawn from children's own environments.
      </p>
    </div>
  </section>

  <!-- Programmes grid -->
  <section style="padding: 5rem 1.5rem; background: var(--color-bg);">
    <div style="max-width: 1000px; margin: 0 auto;">
      <div style="display: grid; gap: 2rem;">
        {programmes.map((programme) => {
          const colors = colorMap[programme.data.color] || { text: 'var(--color-primary)', bg: 'rgba(45, 106, 79, 0.1)' };
          const covers = programmeCovers[programme.data.slug] || [];
          return (
            <article style="
              background: var(--color-surface);
              border: 1px solid var(--color-border);
              border-radius: 16px;
              padding: 2.5rem;
            " class="programme-row">
              <!-- Top row: icon + title + button -->
              <div style="display: grid; grid-template-columns: auto 1fr auto; gap: 2rem; align-items: center; margin-bottom: 1.5rem;" class="programme-top">
                <div style={`
                  width: 72px;
                  height: 72px;
                  border-radius: 16px;
                  background: ${colors.bg};
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  flex-shrink: 0;
                `}>
                  <div style={`
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    background: ${programme.data.color};
                    opacity: 0.7;
                  `} aria-hidden="true"></div>
                </div>

                <div>
                  <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.625rem;">
                    <h2 style="font-family: var(--font-display); font-size: 1.375rem; font-weight: 600; color: var(--color-text); margin: 0;">
                      {programme.data.title}
                    </h2>
                    <span style={`
                      display: inline-block;
                      padding: 0.25rem 0.625rem;
                      background: ${colors.bg};
                      color: ${colors.text};
                      font-size: 0.8125rem;
                      font-weight: 600;
                      border-radius: 99px;
                    `}>
                      {programme.data.ageRange}
                    </span>
                  </div>
                  <p style="font-size: 1rem; color: var(--color-text-muted); line-height: 1.65; margin: 0;">
                    {programme.data.tagline}
                  </p>
                </div>

                <a
                  href={`/programmes/${programme.data.slug}`}
                  style="
                    display: inline-flex;
                    align-items: center;
                    gap: 0.375rem;
                    padding: 0.75rem 1.375rem;
                    background: var(--color-primary);
                    color: #fff;
                    font-size: 0.9375rem;
                    font-weight: 600;
                    text-decoration: none;
                    border-radius: 10px;
                    white-space: nowrap;
                    flex-shrink: 0;
                  "
                >
                  Learn more
                </a>
              </div>

              <!-- Material cover strip -->
              {covers.length > 0 && (
                <div style={`border-top: 1px solid var(--color-border); padding-top: 1.25rem;`}>
                  <p style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted); margin: 0 0 0.75rem;">
                    {programme.data.slug === 'energy' ? 'Coming Soon' : 'Programme Materials'}
                  </p>
                  {programme.data.slug === 'energy' ? (
                    <div style="position: relative; display: inline-flex; gap: 0.625rem;">
                      {covers.map(({ img, label }) => (
                        <div style="border-radius: 6px; overflow: hidden; border: 1px solid var(--color-border); flex-shrink: 0;">
                          <img src={img} alt={label} loading="lazy" style="height: 72px; width: auto; display: block; filter: blur(3px) brightness(0.55);" />
                        </div>
                      ))}
                      <div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;">
                        <span class="pi-cs-badge" style="font-size: 0.6875rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #FFD166; line-height: 1;">Coming Soon</span>
                        <span class="pi-cs-dots" style="font-size: 0.875rem; color: rgba(255,209,102,0.7);">•••</span>
                      </div>
                    </div>
                  ) : (
                    <div style="display: flex; gap: 0.625rem; flex-wrap: wrap;">
                      {covers.map(({ img, label, docId }) => (
                        <a
                          href={`https://issuu.com/happygreenworld/docs/${docId}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          title={label}
                          style="display: block; border-radius: 6px; overflow: hidden; border: 1px solid var(--color-border); flex-shrink: 0; transition: transform 0.2s, box-shadow 0.2s;"
                          onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.12)'"
                          onmouseout="this.style.transform=''; this.style.boxShadow=''"
                        >
                          <img
                            src={img}
                            alt={label}
                            loading="lazy"
                            style="height: 72px; width: auto; display: block;"
                          />
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding: 4rem 1.5rem; background: var(--color-surface); border-top: 1px solid var(--color-border); text-align: center;">
    <div style="max-width: 600px; margin: 0 auto;">
      <h2 style="font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 1.875rem); color: var(--color-text); margin: 0 0 0.875rem;">
        Want to deliver these programmes in your community?
      </h2>
      <p style="font-size: 1rem; color: var(--color-text-muted); line-height: 1.65; margin: 0 0 2rem;">
        We work with schools, NGOs, and organisations worldwide to localise and distribute our materials. Start a conversation with us.
      </p>
      <a
        href="/partner-with-us"
        style="
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          padding: 0.875rem 1.75rem;
          background: var(--color-accent);
          color: var(--color-text);
          font-size: 1rem;
          font-weight: 700;
          text-decoration: none;
          border-radius: 10px;
        "
      >
        Partner With Us →
      </a>
    </div>
  </section>
</PageLayout>

<style>
  @media (max-width: 700px) {
    .programme-top {
      grid-template-columns: 1fr !important;
      gap: 1.25rem !important;
    }
  }

  @keyframes pi-cs-glow {
    0%, 100% { opacity: 1; text-shadow: 0 0 6px rgba(255,209,102,0.7); }
    50% { opacity: 0.6; text-shadow: 0 0 14px rgba(255,209,102,1); }
  }
  @keyframes pi-cs-bounce {
    0%, 100% { letter-spacing: 0.1em; }
    50% { letter-spacing: 0.3em; }
  }
  .pi-cs-badge { animation: pi-cs-glow 1.8s ease-in-out infinite; }
  .pi-cs-dots { animation: pi-cs-bounce 1.4s ease-in-out infinite; }
</style>

