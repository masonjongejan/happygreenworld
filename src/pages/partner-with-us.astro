---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Partner With Us"
  description="Bring Happy Green World's environmental education curriculum to your school, NGO, foundation, or corporate programme. We localise and support — you distribute. Tell us about your community."
>
  <!-- Hero -->
  <section style="
    position: relative;
    padding: 6rem 1.5rem;
    color: #fff;
    overflow: hidden;
    background: #1e4d38;
  ">
    <img
      src="/images/about-indonesia-reading.jpg"
      alt=""
      aria-hidden="true"
      style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.18;"
    />
    <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(30,77,56,0.94) 0%, rgba(45,106,79,0.88) 100%);" aria-hidden="true"></div>

    <div style="max-width: 800px; margin: 0 auto; text-align: center; position: relative;">
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
        <a href="/" style="font-size: 0.875rem; color: rgba(255,255,255,0.65); text-decoration: none;">Home</a>
        <span style="font-size: 0.875rem; color: rgba(255,255,255,0.4); margin: 0 0.5rem;">/</span>
        <span style="font-size: 0.875rem; color: rgba(255,255,255,0.9);">Partner With Us</span>
      </nav>

      <span style="
        display: inline-block;
        padding: 0.375rem 0.875rem;
        background: rgba(244, 162, 97, 0.25);
        color: #FFD166;
        font-size: 0.875rem;
        font-weight: 600;
        border-radius: 99px;
        margin-bottom: 1.5rem;
        letter-spacing: 0.02em;
      ">
        For Schools, NGOs & Organisations
      </span>

      <h1 style="font-family: var(--font-display); font-size: clamp(2.25rem, 5vw, 3.5rem); font-weight: 700; color: #fff; margin: 0 0 1.25rem; line-height: 1.1;">
        Bring environmental education to your community
      </h1>
      <p style="font-size: 1.1875rem; color: rgba(255,255,255,0.8); line-height: 1.7; margin: 0 0 2.5rem; max-width: 600px; margin-left: auto; margin-right: auto;">
        We partner with schools, NGOs, foundations, and sponsors worldwide to localise and deliver our proven environmental curriculum for children aged 6–16. Tell us about your context — we'll handle the rest.
      </p>

      <a
        href="#inquiry-form"
        style="
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          padding: 1rem 2.25rem;
          background: var(--color-accent);
          color: var(--color-text);
          font-size: 1.0625rem;
          font-weight: 700;
          text-decoration: none;
          border-radius: 12px;
          transition: background 0.15s;
        "
      >
        Start the Conversation
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12,5 19,12 12,19"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Who we work with -->
  <section style="padding: 5rem 1.5rem; background: var(--color-bg);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 3rem;">
        <h2 style="font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text); margin: 0 0 0.75rem;">
          Who we work with
        </h2>
        <p style="font-size: 1rem; color: var(--color-text-muted); max-width: 520px; margin: 0 auto; line-height: 1.65;">
          Our partnership model is flexible. Whether you're a single school or a national school network, we can adapt.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem;" class="who-grid">
        {[
          {
            icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
            title: 'Schools & School Networks',
            description: 'Integrate our environmental curriculum into your existing science or sustainability programme. We can provide materials for a single classroom or an entire school network.',
          },
          {
            icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
            title: 'NGOs & Foundations',
            description: 'Co-brand and distribute our localised educational materials within your community or region. We handle the creative and localisation work — you focus on distribution.',
          },
          {
            icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
            title: 'Government & Municipal Bodies',
            description: 'Scale environmental education across public school systems with the backing of an official partnership and proven, localised curriculum materials.',
          },
          {
            icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
            title: 'Corporate Sponsors & CSR Programmes',
            description: 'Fund the localisation of our materials for a new country or language as part of your CSR programme. Your organisation\'s logo can appear on all distributed materials.',
          },
        ].map(({ icon, title, description }) => (
          <article style="
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 16px;
            padding: 2rem;
            display: flex;
            gap: 1.25rem;
            align-items: flex-start;
          ">
            <div style="
              width: 48px;
              height: 48px;
              border-radius: 12px;
              background: rgba(45, 106, 79, 0.1);
              color: var(--color-primary);
              display: flex;
              align-items: center;
              justify-content: center;
              flex-shrink: 0;
            " set:html={icon} />
            <div>
              <h3 style="font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.5rem;">
                {title}
              </h3>
              <p style="font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.65; margin: 0;">
                {description}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section style="padding: 5rem 1.5rem; background: var(--color-surface); border-top: 1px solid var(--color-border);">
    <div style="max-width: 900px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 3.5rem;">
        <h2 style="font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text); margin: 0 0 0.75rem;">
          How it works
        </h2>
        <p style="font-size: 1rem; color: var(--color-text-muted); max-width: 480px; margin: 0 auto; line-height: 1.65;">
          Three straightforward steps from first contact to children in classrooms.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; position: relative;" class="steps-grid">
        {[
          {
            num: 1,
            title: 'Tell us about your context',
            desc: 'Fill in our short inquiry form. We want to understand your organisation, the children you work with, and the environmental challenges in your community.',
          },
          {
            num: 2,
            title: 'We have a conversation',
            desc: 'Our team responds as soon as possible. We\'ll explore together how our materials can be adapted for your country and community, and agree on a plan.',
          },
          {
            num: 3,
            title: 'Launch together',
            desc: 'We handle the localisation and adaptation of materials. You handle distribution to schools and children. Together, we create impact.',
          },
        ].map(({ num, title, desc }, i) => (
          <div style="
            background: var(--color-bg);
            border: 1px solid var(--color-border);
            border-radius: 16px;
            padding: 2rem;
            text-align: center;
            position: relative;
          ">
            <div style="
              width: 48px;
              height: 48px;
              border-radius: 50%;
              background: var(--color-primary);
              color: #fff;
              font-family: var(--font-display);
              font-size: 1.25rem;
              font-weight: 700;
              display: flex;
              align-items: center;
              justify-content: center;
              margin: 0 auto 1.25rem;
            ">
              {num}
            </div>
            <h3 style="font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.625rem;">
              {title}
            </h3>
            <p style="font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.65; margin: 0;">
              {desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What you get -->
  <section style="padding: 5rem 1.5rem; background: var(--color-bg); border-top: 1px solid var(--color-border);">
    <div style="max-width: 900px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 3rem;">
        <h2 style="font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text); margin: 0 0 0.75rem;">
          What the partnership looks like
        </h2>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;" class="partnership-grid">
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 16px; padding: 2rem;">
          <h3 style="font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; color: var(--color-primary); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--color-primary); flex-shrink: 0;"></span>
            What Happy Green World provides
          </h3>
          <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.875rem;">
            {[
              'Localised activity guides and student workbooks',
              'Culturally adapted illustrations by our illustrator Petra',
              'Co-branding with your organisation\'s logo on all materials',
              'Customised action plan and project timeline',
              'Expert advice and ongoing support',
              'Promotional materials to announce the programme',
            ].map((item) => (
              <li style="display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.5;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5" stroke-linecap="round" style="flex-shrink: 0; margin-top: 2px;" aria-hidden="true">
                  <polyline points="20,6 9,17 4,12"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 16px; padding: 2rem;">
          <h3 style="font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; color: var(--color-text-muted); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--color-text-muted); flex-shrink: 0;"></span>
            What partners contribute
          </h3>
          <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.875rem;">
            {[
              'Distribution to schools and children in your community',
              'Local sponsorship to cover printing and production costs',
              'Translation support for local languages where needed',
              'On-the-ground feedback to help us improve materials',
              'A shared commitment to a lasting, sustainable partnership',
            ].map((item) => (
              <li style="display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.5;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-muted)" stroke-width="2.5" stroke-linecap="round" style="flex-shrink: 0; margin-top: 2px;" aria-hidden="true">
                  <polyline points="20,6 9,17 4,12"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Social proof -->
  <section style="padding: 4rem 1.5rem; background: rgba(45, 106, 79, 0.05); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
    <div style="max-width: 900px; margin: 0 auto; text-align: center;">
      <p style="font-size: 1.125rem; font-weight: 600; color: var(--color-text); margin: 0 0 1.5rem;">
        Join our global network of 42 partners in 26 countries
      </p>
      <p style="font-size: 0.9375rem; color: var(--color-text-muted); margin: 0; line-height: 1.65;">
        Including partners in <strong>Cameroon, Congo, Egypt, Ethiopia, Indonesia, Ecuador, Senegal, Sierra Leone, Thailand, Netherlands,</strong> and <strong>Australia.</strong>
      </p>
      <a href="/our-projects" style="display: inline-block; margin-top: 1.25rem; font-size: 0.9375rem; font-weight: 600; color: var(--color-primary); text-decoration: underline; text-underline-offset: 3px;">
        See all our partners →
      </a>
    </div>
  </section>

  <!-- Inquiry form -->
  <section id="inquiry-form" style="padding: 5rem 1.5rem; background: var(--color-bg);">
    <div style="max-width: 720px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 3rem;">
        <h2 style="font-family: var(--font-display); font-size: clamp(1.75rem, 3vw, 2.25rem); color: var(--color-text); margin: 0 0 0.75rem;">
          Start a Conversation
        </h2>
        <p style="font-size: 1rem; color: var(--color-text-muted); line-height: 1.65; margin: 0;">
          Complete this short form and we'll be in touch as soon as possible. There's no commitment required — just a conversation.
        </p>
      </div>

      <div style="
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 20px;
        padding: 3rem;
      ">
        <form
          name="partner-inquiry"
          method="POST"
          data-netlify="true"
          action="/thank-you"
          style="display: flex; flex-direction: column; gap: 1.5rem;"
        >
          <input type="hidden" name="form-name" value="partner-inquiry" />
          <p style="display: none;">
            <label>Don't fill this out if you're human: <input name="bot-field" /></label>
          </p>

          <!-- Row 1: Name + Email -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;" class="form-row">
            <div>
              <label for="full-name" style="display: block; font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
                Full Name <span style="color: #c0392b;" aria-label="required">*</span>
              </label>
              <input
                type="text"
                id="full-name"
                name="full-name"
                required
                autocomplete="name"
                style="
                  width: 100%;
                  padding: 0.75rem 1rem;
                  border: 1.5px solid var(--color-border);
                  border-radius: 10px;
                  font-family: var(--font-body);
                  font-size: 1rem;
                  color: var(--color-text);
                  background: var(--color-bg);
                  box-sizing: border-box;
                  transition: border-color 0.15s;
                "
              />
            </div>
            <div>
              <label for="email" style="display: block; font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
                Email Address <span style="color: #c0392b;" aria-label="required">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                style="
                  width: 100%;
                  padding: 0.75rem 1rem;
                  border: 1.5px solid var(--color-border);
                  border-radius: 10px;
                  font-family: var(--font-body);
                  font-size: 1rem;
                  color: var(--color-text);
                  background: var(--color-bg);
                  box-sizing: border-box;
                  transition: border-color 0.15s;
                "
              />
            </div>
          </div>

          <!-- Organisation name -->
          <div>
            <label for="org-name" style="display: block; font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
              Organisation Name <span style="color: #c0392b;" aria-label="required">*</span>
            </label>
            <input
              type="text"
              id="org-name"
              name="organisation-name"
              required
              autocomplete="organization"
              style="
                width: 100%;
                padding: 0.75rem 1rem;
                border: 1.5px solid var(--color-border);
                border-radius: 10px;
                font-family: var(--font-body);
                font-size: 1rem;
                color: var(--color-text);
                background: var(--color-bg);
                box-sizing: border-box;
                transition: border-color 0.15s;
              "
            />
          </div>

          <!-- Row 2: Organisation type + Country -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;" class="form-row">
            <div>
              <label for="org-type" style="display: block; font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
                Organisation Type <span style="color: #c0392b;" aria-label="required">*</span>
              </label>
              <select
                id="org-type"
                name="organisation-type"
                required
                style="
                  width: 100%;
                  padding: 0.75rem 1rem;
                  border: 1.5px solid var(--color-border);
                  border-radius: 10px;
                  font-family: var(--font-body);
                  font-size: 1rem;
                  color: var(--color-text);
                  background: var(--color-bg);
                  box-sizing: border-box;
                  appearance: none;
                  cursor: pointer;
                "
              >
                <option value="" disabled selected>Select type…</option>
                <option>School or School Network</option>
                <option>NGO or Foundation</option>
                <option>Government / Municipal Body</option>
                <option>Corporate Sponsor / CSR Programme</option>
                <option>University or Research Institution</option>
                <option>Individual / Freelance Educator</option>
                <option>Other</option>
              </select>
            </div>
            <div>
              <label for="country" style="display: block; font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
                Country <span style="color: #c0392b;" aria-label="required">*</span>
              </label>
              <input
                type="text"
                id="country"
                name="country"
                required
                autocomplete="country-name"
                placeholder="e.g. Kenya"
                style="
                  width: 100%;
                  padding: 0.75rem 1rem;
                  border: 1.5px solid var(--color-border);
                  border-radius: 10px;
                  font-family: var(--font-body);
                  font-size: 1rem;
                  color: var(--color-text);
                  background: var(--color-bg);
                  box-sizing: border-box;
                  transition: border-color 0.15s;
                "
              />
            </div>
          </div>

          <!-- Estimated reach -->
          <div>
            <label for="reach" style="display: block; font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
              How many children could you reach?
            </label>
            <select
              id="reach"
              name="estimated-reach"
              style="
                width: 100%;
                padding: 0.75rem 1rem;
                border: 1.5px solid var(--color-border);
                border-radius: 10px;
                font-family: var(--font-body);
                font-size: 1rem;
                color: var(--color-text);
                background: var(--color-bg);
                box-sizing: border-box;
                appearance: none;
                cursor: pointer;
              "
            >
              <option value="" selected>Not sure yet</option>
              <option>Under 100</option>
              <option>100–500</option>
              <option>500–2,000</option>
              <option>2,000–10,000</option>
              <option>More than 10,000</option>
            </select>
          </div>

          <!-- Topics of interest -->
          <fieldset style="border: 1.5px solid var(--color-border); border-radius: 10px; padding: 1.25rem 1.5rem; margin: 0;">
            <legend style="font-size: 0.875rem; font-weight: 600; color: var(--color-text); padding: 0 0.5rem;">
              Which topic areas interest you?
            </legend>
            <div style="display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 0.75rem;">
              {[
                { value: 'waste', label: 'Waste & Recycling' },
                { value: 'water', label: 'Water & Conservation' },
                { value: 'energy', label: 'Energy & Climate' },
                { value: 'all', label: 'All three / Full curriculum' },
              ].map(({ value, label }) => (
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.9375rem; color: var(--color-text);">
                  <input
                    type="checkbox"
                    name="topics"
                    value={value}
                    style="width: 16px; height: 16px; accent-color: var(--color-primary);"
                  />
                  {label}
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Context textarea -->
          <div>
            <label for="context" style="display: block; font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
              Tell us about your context <span style="color: #c0392b;" aria-label="required">*</span>
            </label>
            <textarea
              id="context"
              name="context"
              required
              rows="5"
              placeholder="Tell us about your organisation, the community you serve, and why environmental education matters to you right now…"
              style="
                width: 100%;
                padding: 0.875rem 1rem;
                border: 1.5px solid var(--color-border);
                border-radius: 10px;
                font-family: var(--font-body);
                font-size: 1rem;
                color: var(--color-text);
                background: var(--color-bg);
                box-sizing: border-box;
                resize: vertical;
                min-height: 120px;
                transition: border-color 0.15s;
              "
            ></textarea>
          </div>

          <!-- How did you hear -->
          <div>
            <label for="referral" style="display: block; font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
              How did you hear about us?
            </label>
            <select
              id="referral"
              name="referral-source"
              style="
                width: 100%;
                padding: 0.75rem 1rem;
                border: 1.5px solid var(--color-border);
                border-radius: 10px;
                font-family: var(--font-body);
                font-size: 1rem;
                color: var(--color-text);
                background: var(--color-bg);
                box-sizing: border-box;
                appearance: none;
                cursor: pointer;
              "
            >
              <option value="">Prefer not to say</option>
              <option>Google search</option>
              <option>Social media (Facebook / Instagram)</option>
              <option>Word of mouth</option>
              <option>Existing Happy Green World partner</option>
              <option>Conference or event</option>
              <option>Other</option>
            </select>
          </div>

          <!-- Privacy note -->
