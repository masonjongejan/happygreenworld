---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const downloads = (await getCollection('downloads')).sort((a, b) => a.data.order - b.data.order);
const coloringSheets = downloads.filter(d => d.data.type === 'coloring');

const videos = [
  {
    title: 'Towards a Happy Green World',
    description: 'An introduction to the Happy Green World Foundation — our mission, our work, and the children we serve.',
    embedUrl: 'https://www.youtube.com/embed/A5K4K0ylqpM',
  },
  {
    title: 'The Clean and Green Senegal Lesson',
    description: 'See our environmental education programme in action in Senegal, delivered by our local partner Casades.',
    embedUrl: 'https://www.youtube.com/embed/DbJ2nEyLKYQ',
  },
  {
    title: 'Green Indonesia Recycling Education Programme',
    description: 'The Indonesian Waste Platform delivers Happy Green World\'s recycling curriculum to children across Indonesia.',
    embedUrl: 'https://www.youtube.com/embed/1rWNz1RBd9U',
  },
];

const publications = [
  {
    region: 'Africa — English',
    items: [
      { title: 'Happy Green Tanzania Student Book', docId: 'issuuhgtsb', img: 'https://image.isu.pub/241107155913-594b6739615cc3a01953ad97b7ad48dc/jpg/page_1_thumb_large.jpg' },
      { title: 'Happy Green Tanzania Activity Guide', docId: '031024aghappygreentanzaniaengels', img: 'https://image.isu.pub/241107154947-bf1e5f463bf1098e1ff2a7f9b092b2fe/jpg/page_1_thumb_large.jpg' },
      { title: 'Happy Green Tanzania Board Game', docId: '031024happygreentanzaniabg', img: 'https://image.isu.pub/241107161605-c4c8aa09c23c215f5d0fa6056cf4fe08/jpg/page_1_thumb_large.jpg' },
      { title: 'Kilimanjaro Game', docId: '4.03_kilimanjaro_game_front__back', img: 'https://image.isu.pub/200619061438-498ac70952ead53a0c49a825689ee3a4/jpg/page_1_thumb_large.jpg' },
    ],
  },
  {
    region: 'Africa — French',
    items: [
      { title: 'Activity Guide Afrique Propre et Verte', docId: 'activity_guide_afrique_propre_et_verte', img: 'https://image.isu.pub/250602144921-11cac8b0eb198652038280b19da1deff/jpg/page_1_thumb_large.jpg' },
      { title: "L'Afrique Propre et Verte — Cahier de l'élève", docId: '100821afriquepropreetvert', img: 'https://image.isu.pub/230213155024-a3104178e983ddea46e0da56fa04ab2b/jpg/page_1_thumb_large.jpg' },
      { title: "Le Jeu L'Afrique Propre et Verte", docId: '100729hgaboardgame', img: 'https://image.isu.pub/210810072016-6b5e1853e58ef0c1a92297adc523b445/jpg/page_1_thumb_large.jpg' },
      { title: 'Happy Green Madagascar', docId: '300723happygreenmadagascar', img: 'https://image.isu.pub/240125142610-12423a3fa0597616623458a204b457d6/jpg/page_1_thumb_large.jpg' },
    ],
  },
  {
    region: 'Asia & Pacific',
    items: [
      { title: 'Generasi Bersih Indonesia Student Book', docId: 'generasi_bersih_indonesia_student_book', img: 'https://image.isu.pub/260508145224-21eb35d9e9bfcc7c07dcf663409635d4/jpg/page_1_thumb_large.jpg' },
      { title: 'Generasi Bersih Indonesia Activity Guide', docId: 'generasi_bersih_indonesia_-_panduan_kegiatan_', img: 'https://image.isu.pub/260508151514-3a85c04be510d2cfc80bf807f0ce8b91/jpg/page_1_thumb_large.jpg' },
      { title: 'Boardgame Generasi Bersih Indonesia', docId: '_boardgame_genera_i_bersih_indonesia', img: 'https://image.isu.pub/260508143815-587efc2687f96ac0379284c7c405b807/jpg/page_1_thumb_large.jpg' },
      { title: 'Selamat Menghijaukan Indonesia Student Book', docId: '180724sbhgifinal', img: 'https://image.isu.pub/241114130250-7f5ccc664a345afe01d376d9ae46f1ca/jpg/page_1_thumb_large.jpg' },
      { title: 'Panduan Kegiatan Selamat Menghijaukan Indonesia', docId: '31082024aghgi', img: 'https://image.isu.pub/241114125949-78e0d02a747141a48b15f95f0e7bebfb/jpg/page_1_thumb_large.jpg' },
      { title: 'Happy Green Indonesia Board Game', docId: '01072024bghgi', img: 'https://image.isu.pub/241114124814-fea32628cc6b11a2710803604cf194ba/jpg/page_1_thumb_large.jpg' },
      { title: 'Happy Green Philippines Student Book', docId: '200224sbhgp', img: 'https://image.isu.pub/240326202259-c30fc83bec9800a45efb8f4ddfd41a74/jpg/page_1_thumb_large.jpg' },
      { title: 'Happy Green Philippines Activity Guide', docId: '200224hgpag', img: 'https://image.isu.pub/240326200958-cfe841a37b46d76d96bde4cae985be1a/jpg/page_1_thumb_large.jpg' },
      { title: 'Happy Green Philippines Waste Game', docId: '200224boardgamehgp', img: 'https://image.isu.pub/240326195802-b2a12b44ef362b23b1684ca814e2445d/jpg/page_1_thumb_large.jpg' },
      { title: 'Happy Green Vietnam Student Book', docId: '030924sbvietnam', img: 'https://image.isu.pub/241113152958-7312cdd7f4c51bc3673e825cec5ad743/jpg/page_1_thumb_large.jpg' },
      { title: 'Happy Green Vietnam Activity Guide', docId: 'agvietnam30082024', img: 'https://image.isu.pub/241113111824-69ec82d9dce708d9346d2fac78b973bd/jpg/page_1_thumb_large.jpg' },
      { title: 'Happy Green Vietnam Waste Game', docId: '170724hgvbg', img: 'https://image.isu.pub/241113111346-03e5ac20d3b61e0162860d31a49e463d/jpg/page_1_thumb_large.jpg' },
      { title: 'Happy Green Thailand', docId: 'thai_student_book_pdf_print', img: 'https://image.isu.pub/231110125133-6c4744789101a1b91ec85875f95b4fa8/jpg/page_1_thumb_large.jpg' },
      { title: 'Endangered Aussie Animal Game', docId: '18-2-2022aussieendangeredanimalgameissuu', img: 'https://image.isu.pub/220218061030-35011563e4b03cdf416d4e7c97e2640b/jpg/page_1_thumb_large.jpg' },
    ],
  },
  {
    region: 'Americas',
    items: [
      { title: 'Galápagos Verde y Feliz — Libro del alumno', docId: 'gal_pagos_verde_y_feliz_-_libro_del_alumno', img: 'https://image.isu.pub/251210131709-c8b5faaceec929afaad996f222702c58/jpg/page_1_thumb_large.jpg' },
      { title: 'Guía de actividades Galápagos Verde Y Feliz', docId: '10.12.2025aggalapagosverdeyfelizcopy', img: 'https://image.isu.pub/251210142952-8dbcf4c5a09b22119e58ca253310f48f/jpg/page_1_thumb_large.jpg' },
      { title: 'Juego Galápagos Verde y Feliz', docId: 'juego_gal_pagos_verde_y_feliz', img: 'https://image.isu.pub/251201141354-cb68301c28e7f4f641e95582cdc9105c/jpg/page_1_thumb_large.jpg' },
      { title: 'Peru Verde Y Feliz', docId: '141121sbperu', img: 'https://image.isu.pub/240607123057-614d9fc766fb75d9d48fd204e625d461/jpg/page_1_thumb_large.jpg' },
    ],
  },
  {
    region: 'Global',
    items: [
      { title: 'Happy Green World Water Game', docId: '19.6.2020_hgw_water_game.issuu', img: 'https://image.isu.pub/200619055200-cf0bd72947dcc96efe96ef8f4b72a7df/jpg/page_1_thumb_large.jpg' },
    ],
  },
];
---

<PageLayout
  title="Resources"
  description="Browse Happy Green World's full library of student books, activity guides, and board games on Issuu — covering waste, water, and energy education in 9 languages across 25 countries."
>
  <!-- Hero -->
  <section style="background: linear-gradient(135deg, #2D6A4F 0%, #1e4d38 100%); padding: 5rem 1.5rem; color: #fff;">
    <div style="max-width: 800px; margin: 0 auto; text-align: center;">
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
        <a href="/" style="font-size: 0.875rem; color: rgba(255,255,255,0.65); text-decoration: none;">Home</a>
        <span style="font-size: 0.875rem; color: rgba(255,255,255,0.4); margin: 0 0.5rem;">/</span>
        <span style="font-size: 0.875rem; color: rgba(255,255,255,0.9);">Resources</span>
      </nav>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; color: #fff; margin: 0 0 1rem;">
        Educational Resources
      </h1>
      <p style="font-size: 1.125rem; color: rgba(255,255,255,0.8); line-height: 1.7; margin: 0; max-width: 600px; margin-left: auto; margin-right: auto;">
        Browse our full library of materials on Issuu, download free coloring sheets, or watch our programmes in action.
      </p>

      <div style="display: flex; gap: 0.875rem; justify-content: center; margin-top: 2rem; flex-wrap: wrap;">
        <a href="#materials" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: rgba(255,255,255,0.15); color: #fff; font-size: 0.9375rem; font-weight: 600; text-decoration: none; border-radius: 10px; border: 1px solid rgba(255,255,255,0.25);">
          Our Materials
        </a>
        <a href="#publications" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: rgba(255,255,255,0.15); color: #fff; font-size: 0.9375rem; font-weight: 600; text-decoration: none; border-radius: 10px; border: 1px solid rgba(255,255,255,0.25);">
          All Publications
        </a>
        <a href="#videos" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: rgba(255,255,255,0.15); color: #fff; font-size: 0.9375rem; font-weight: 600; text-decoration: none; border-radius: 10px; border: 1px solid rgba(255,255,255,0.25);">
          Videos
        </a>
      </div>
    </div>
  </section>

  <!-- Issuu link card -->
  <section id="materials" style="padding: 5rem 1.5rem; background: var(--color-bg);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="margin-bottom: 2.5rem;">
        <h2 style="font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text); margin: 0 0 0.75rem;">
          Browse Our Materials
        </h2>
        <p style="font-size: 1rem; color: var(--color-text-muted); margin: 0; line-height: 1.65; max-width: 680px;">
          Our full library of student books, activity guides, and board games is available on Issuu — covering waste, water, and energy programmes in 9 languages across 25 countries.
        </p>
      </div>

      <!-- Featured preview covers -->
      <div style="display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap;" class="featured-covers">
        {[
          { title: 'Happy Green Tanzania Student Book', docId: 'issuuhgtsb', img: 'https://image.isu.pub/241107155913-594b6739615cc3a01953ad97b7ad48dc/jpg/page_1_thumb_large.jpg' },
          { title: 'Happy Green Tanzania Board Game', docId: '031024happygreentanzaniabg', img: 'https://image.isu.pub/241107161605-c4c8aa09c23c215f5d0fa6056cf4fe08/jpg/page_1_thumb_large.jpg' },
          { title: 'Happy Green Philippines Student Book', docId: '200224sbhgp', img: 'https://image.isu.pub/240326202259-c30fc83bec9800a45efb8f4ddfd41a74/jpg/page_1_thumb_large.jpg' },
          { title: 'Happy Green Philippines Waste Game', docId: '200224boardgamehgp', img: 'https://image.isu.pub/240326195802-b2a12b44ef362b23b1684ca814e2445d/jpg/page_1_thumb_large.jpg' },
          { title: 'HGW Water Game', docId: '19.6.2020_hgw_water_game.issuu', img: 'https://image.isu.pub/200619055200-cf0bd72947dcc96efe96ef8f4b72a7df/jpg/page_1_thumb_large.jpg' },
          { title: 'Galápagos Verde y Feliz', docId: 'gal_pagos_verde_y_feliz_-_libro_del_alumno', img: 'https://image.isu.pub/251210131709-c8b5faaceec929afaad996f222702c58/jpg/page_1_thumb_large.jpg' },
        ].map(({ title, docId, img }) => (
          <a
            href={`https://issuu.com/happygreenworld/docs/${docId}`}
            target="_blank"
            rel="noopener noreferrer"
            title={title}
            class="feat-cover"
            style="display: block; flex-shrink: 0; border-radius: 8px; overflow: hidden; border: 1px solid var(--color-border); box-shadow: 0 2px 8px rgba(0,0,0,0.07); transition: transform 0.2s, box-shadow 0.2s;"
            onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 6px 20px rgba(0,0,0,0.14)'"
            onmouseout="this.style.transform=''; this.style.boxShadow='0 2px 8px rgba(0,0,0,0.07)'"
          >
            <img src={img} alt={title} loading="lazy" style="height: 140px; width: auto; display: block;" />
          </a>
        ))}
      </div>

      <!-- Issuu CTA card -->
      <a
        href="https://issuu.com/happygreenworld?ps=24"
        target="_blank"
        rel="noopener noreferrer"
        style="
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 1.5rem;
          padding: 1.75rem 2rem;
          background: var(--color-primary);
          color: #fff;
          text-decoration: none;
          border-radius: 14px;
          transition: background 0.2s;
        "
        onmouseover="this.style.background='#1e4d38'"
        onmouseout="this.style.background='var(--color-primary)'"
      >
        <div>
          <p style="font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; margin: 0 0 0.25rem; color: #fff;">
            View all 27 publications on Issuu
          </p>
          <p style="font-size: 0.9375rem; color: rgba(255,255,255,0.75); margin: 0;">
            Student books · Activity guides · Board games · 9 languages
          </p>
        </div>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.8)" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="flex-shrink: 0;">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Publications gallery -->
  <section id="publications" style="padding: 5rem 1.5rem; background: var(--color-surface); border-top: 1px solid var(--color-border);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="margin-bottom: 3rem;">
        <h2 style="font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text); margin: 0 0 0.75rem;">
          Our Publications Around the World
        </h2>
        <p style="font-size: 1rem; color: var(--color-text-muted); margin: 0; line-height: 1.65; max-width: 680px;">
          Every Happy Green World programme is localised for its community — custom illustrations, local language, and culturally relevant content. Click any cover to read it on Issuu.
        </p>
      </div>

      {publications.map(({ region, items }) => (
        <div style="margin-bottom: 3rem;">
          <h3 style="
            font-family: var(--font-body);
            font-size: 0.8125rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--color-text-muted);
            margin: 0 0 1.25rem;
            padding-bottom: 0.625rem;
            border-bottom: 1px solid var(--color-border);
          ">
            {region}
          </h3>
          <div class="pub-grid">
            {items.map(({ title, docId, img }) => (
              <a
                href={`https://issuu.com/happygreenworld/docs/${docId}`}
                target="_blank"
                rel="noopener noreferrer"
                style="text-decoration: none; color: inherit;"
                class="pub-card"
              >
                <div style="
                  aspect-ratio: 4/5;
                  border-radius: 8px;
                  overflow: hidden;
                  border: 1px solid var(--color-border);
                  background: rgba(45, 106, 79, 0.04);
                  margin-bottom: 0.625rem;
                ">
                  <img
                    src={img}
                    alt={title}
                    loading="lazy"
                    style="width: 100%; height: 100%; object-fit: cover; display: block;"
                  />
                </div>
                <p style="
                  font-size: 0.75rem;
                  line-height: 1.4;
                  color: var(--color-text);
                  margin: 0;
                  display: -webkit-box;
                  -webkit-line-clamp: 3;
                  -webkit-box-orient: vertical;
                  overflow: hidden;
                ">
                  {title}
                </p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Coloring sheets -->
  <section id="downloads" style="padding: 5rem 1.5rem; background: var(--color-bg); border-top: 1px solid var(--color-border);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <h2 style="font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.625rem); color: var(--color-text); margin: 0 0 0.75rem;">
        Coloring Sheets
      </h2>
      <p style="font-size: 1rem; color: var(--color-text-muted); margin: 0 0 2rem; line-height: 1.65;">
        Free printable coloring sheets for younger children.
      </p>

      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; max-width: 640px;" class="coloring-grid">
        {coloringSheets.map((item) => (
          <article style="
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 14px;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
          ">
            <div style="
              width: 100%;
              aspect-ratio: 4/3;
              border-radius: 8px;
              background: rgba(45, 106, 79, 0.06);
              margin-bottom: 1rem;
              overflow: hidden;
              display: flex;
              align-items: center;
              justify-content: center;
            ">
              <img
                src={item.data.filename === 'coloringsheetanimals.pdf' ? '/images/download-coloring-sheet-animals.png' : '/images/download-colorsheet-hgw.png'}
                alt={item.data.title}
                style="width: 100%; height: 100%; object-fit: cover;"
                loading="lazy"
              />
            </div>
            <h3 style="font-family: var(--font-display); font-size: 1rem; font-weight: 600; color: var(--color-text); margin: 0 0 1rem; flex: 1;">
              {item.data.title}
            </h3>
            <a
              href={`/downloads/${item.data.filename}`}
              download
              style="
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
                padding: 0.625rem 1rem;
                background: rgba(45, 106, 79, 0.08);
                color: var(--color-primary);
                font-size: 0.875rem;
                font-weight: 600;
                text-decoration: none;
                border-radius: 8px;
                border: 1px solid rgba(45, 106, 79, 0.2);
              "
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Download PDF
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Videos section -->
  <section id="videos" style="padding: 5rem 1.5rem; background: var(--color-surface); border-top: 1px solid var(--color-border);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <h2 style="font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text); margin: 0 0 0.75rem;">
        Videos
      </h2>
      <p style="font-size: 1rem; color: var(--color-text-muted); margin: 0 0 2.5rem; line-height: 1.65;">
        Watch Happy Green World's programmes in action — from our foundation story to classroom lessons delivered by our partners around the world.
      </p>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;" class="videos-grid">
        {videos.map(({ title, description, embedUrl }) => (
          <article style="
            background: var(--color-bg);
            border: 1px solid var(--color-border);
            border-radius: 14px;
            overflow: hidden;
          ">
            <div style="position: relative; aspect-ratio: 16/9; background: #1A2E1A;">
              <iframe
                src={embedUrl}
                title={title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                style="position: absolute; inset: 0; width: 100%; height: 100%; border: none;"
              />
            </div>
            <div style="padding: 1.25rem;">
              <h3 style="font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.5rem;">
                {title}
              </h3>
              <p style="font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.6; margin: 0;">
                {description}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Partner CTA -->
  <section style="padding: 4rem 1.5rem; background: var(--color-bg); border-top: 1px solid var(--color-border); text-align: center;">
    <div style="max-width: 560px; margin: 0 auto;">
      <h2 style="font-family: var(--font-display); font-size: clamp(1.375rem, 2.5vw, 1.75rem); color: var(--color-text); margin: 0 0 0.75rem;">
        Want to use these materials in your school or community?
      </h2>
      <p style="font-size: 1rem; color: var(--color-text-muted); line-height: 1.65; margin: 0 0 2rem;">
        We localise and adapt our materials for each partner. Get in touch to find out how we can work together.
      </p>
      <a
        href="/partner-with-us"
        style="
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          padding: 0.875rem 1.75rem;
          background: var(--color-accent);
          color: var(--color-text);
          font-size: 1rem;
          font-weight: 700;
          text-decoration: none;
          border-radius: 10px;
        "
      >
        Partner With Us →
      </a>
    </div>
  </section>
</PageLayout>

<style>
  .pub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
  }
  .pub-card {
    transition: transform 0.2s, opacity 0.2s;
  }
  .pub-card:hover {
    transform: translateY(-3px);
    opacity: 0.85;
  }
  @media (max-width: 600px) {
    .pub-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 0.75rem; }
    .coloring-grid { grid-template-columns: 1fr !important; }
    .videos-grid { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 900px) {
    .videos-grid { grid-template-columns: 1fr !important; }
  }
</style>
