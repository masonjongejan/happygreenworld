---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const downloads = (await getCollection('downloads')).sort((a, b) => a.data.order - b.data.order);
const coloringSheets = downloads.filter(d => d.data.type === 'coloring');

const languages = [
  {
    name: 'English',
    img: 'https://image.isu.pub/241107155913-594b6739615cc3a01953ad97b7ad48dc/jpg/page_1_thumb_large.jpg',
    url: 'https://issuu.com/happygreenworld/docs/issuuhgtsb',
  },
  {
    name: 'French',
    img: 'https://image.isu.pub/250602144921-11cac8b0eb198652038280b19da1deff/jpg/page_1_thumb_large.jpg',
    url: 'https://issuu.com/happygreenworld/docs/activity_guide_afrique_propre_et_verte',
  },
  {
    name: 'Bahasa Indonesia',
    img: 'https://image.isu.pub/260508145224-21eb35d9e9bfcc7c07dcf663409635d4/jpg/page_1_thumb_large.jpg',
    url: 'https://issuu.com/happygreenworld/docs/generasi_bersih_indonesia_student_book',
  },
  {
    name: 'Spanish',
    img: 'https://image.isu.pub/251210131709-c8b5faaceec929afaad996f222702c58/jpg/page_1_thumb_large.jpg',
    url: 'https://issuu.com/happygreenworld/docs/gal_pagos_verde_y_feliz_-_libro_del_alumno',
  },
  {
    name: 'Vietnamese',
    img: 'https://image.isu.pub/241113152958-7312cdd7f4c51bc3673e825cec5ad743/jpg/page_1_thumb_large.jpg',
    url: 'https://issuu.com/happygreenworld/docs/030924sbvietnam',
  },
  {
    name: 'Khmer',
    img: null,
    url: 'https://issuu.com/happygreenworld',
  },
  {
    name: 'Swahili',
    img: null,
    url: 'https://issuu.com/happygreenworld',
  },
  {
    name: 'Arabic',
    img: null,
    url: 'https://issuu.com/happygreenworld',
  },
  {
    name: 'Dutch',
    img: 'https://image.isu.pub/200619055200-cf0bd72947dcc96efe96ef8f4b72a7df/jpg/page_1_thumb_large.jpg',
    url: 'https://issuu.com/happygreenworld/docs/19.6.2020_hgw_water_game.issuu',
  },
  {
    name: 'Thai',
    img: 'https://image.isu.pub/231110125133-6c4744789101a1b91ec85875f95b4fa8/jpg/page_1_thumb_large.jpg',
    url: 'https://issuu.com/happygreenworld/docs/thai_student_book_pdf_print',
  },
];
---

<PageLayout
  title="Educational Resources"
  description="Browse Happy Green World's educational materials by language — student books, activity guides, and board games on waste, water, and energy in 10 languages."
>
  <!-- Hero -->
  <section style="background: linear-gradient(135deg, #2D6A4F 0%, #1e4d38 100%); padding: 5rem 1.5rem; color: #fff;">
    <div style="max-width: 800px; margin: 0 auto; text-align: center;">
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
        <a href="/" style="font-size: 0.875rem; color: rgba(255,255,255,0.65); text-decoration: none;">Home</a>
        <span style="font-size: 0.875rem; color: rgba(255,255,255,0.4); margin: 0 0.5rem;">/</span>
        <span style="font-size: 0.875rem; color: rgba(255,255,255,0.9);">Resources</span>
      </nav>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; color: #fff; margin: 0 0 1rem;">
        Educational Resources
      </h1>
      <p style="font-size: 1.125rem; color: rgba(255,255,255,0.8); line-height: 1.7; margin: 0; max-width: 600px; margin-left: auto; margin-right: auto;">
        Browse our educational resources by language, download free colouring sheets, and watch our programmes in action in videos.
      </p>
    </div>
  </section>

  <!-- Browse by Language -->
  <section style="padding: 5rem 1.5rem; background: var(--color-bg);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="margin-bottom: 3rem; text-align: center;">
        <h2 style="font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text); margin: 0 0 0.75rem;">
          Browse Our Educational Resources
        </h2>
        <p style="font-size: 1rem; color: var(--color-text-muted); max-width: 560px; margin: 0 auto; line-height: 1.65;">
          Available in 10 languages — click a language to explore the materials on Issuu.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.25rem;" class="lang-grid">
        {languages.map(({ name, img, url }) => (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            style="
              display: flex;
              flex-direction: column;
              background: var(--color-surface);
              border: 1px solid var(--color-border);
              border-radius: 14px;
              overflow: hidden;
              text-decoration: none;
              transition: transform 0.2s, box-shadow 0.2s;
            "
            onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 24px rgba(0,0,0,0.1)'"
            onmouseout="this.style.transform=''; this.style.boxShadow=''"
          >
            <div style="width: 100%; aspect-ratio: 3/4; overflow: hidden; background: rgba(45,106,79,0.07);">
              {img ? (
                <img
                  src={img}
                  alt={`${name} educational materials`}
                  loading="lazy"
                  style="width: 100%; height: 100%; object-fit: cover; display: block;"
                />
              ) : (
                <div style="width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem;">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="rgba(45,106,79,0.4)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                  <span style="font-size: 0.6875rem; color: rgba(45,106,79,0.5); text-align: center; padding: 0 0.5rem;">Coming soon</span>
                </div>
              )}
            </div>
            <div style="padding: 0.875rem 0.75rem; text-align: center;">
              <span style="font-family: var(--font-display); font-size: 0.9375rem; font-weight: 700; color: var(--color-text);">{name}</span>
              <div style="display: flex; align-items: center; justify-content: center; gap: 0.3rem; margin-top: 0.3rem;">
                <span style="font-size: 0.75rem; color: var(--color-primary); font-weight: 600;">View on Issuu</span>
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12,5 19,12 12,19"/></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Coloring sheets -->
  <section style="padding: 5rem 1.5rem; background: var(--color-surface); border-top: 1px solid var(--color-border);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="margin-bottom: 2rem;">
        <h2 style="font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.625rem); color: var(--color-text); margin: 0 0 0.5rem;">
          Download Free Colouring Sheets
        </h2>
        <p style="font-size: 1rem; color: var(--color-text-muted); margin: 0; line-height: 1.65;">
          Free printable colouring sheets for younger children — great for introducing environmental topics through art.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; max-width: 640px;" class="coloring-grid">
        {coloringSheets.map((item) => (
          <article style="background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 14px; padding: 1.5rem; display: flex; flex-direction: column;">
            <div style="width: 100%; aspect-ratio: 4/3; border-radius: 8px; background: rgba(45, 106, 79, 0.06); margin-bottom: 1rem; overflow: hidden; display: flex; align-items: center; justify-content: center;">
              <img
                src={item.data.filename === 'coloringsheetanimals.pdf' ? '/images/download-coloring-sheet-animals.png' : '/images/download-colorsheet-hgw.png'}
                alt={item.data.title}
                style="width: 100%; height: 100%; object-fit: cover;"
                loading="lazy"
              />
            </div>
            <h3 style="font-family: var(--font-display); font-size: 1rem; font-weight: 600; color: var(--color-text); margin: 0 0 1rem; flex: 1;">
              {item.data.title}
            </h3>
            <a
              href={`/downloads/${item.data.filename}`}
              download
              style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.625rem 1rem; background: rgba(45, 106, 79, 0.08); color: var(--color-primary); font-size: 0.875rem; font-weight: 600; text-decoration: none; border-radius: 8px; border: 1px solid rgba(45, 106, 79, 0.2);"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download PDF
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Watch videos -->
  <section style="padding: 3rem 1.5rem; background: var(--color-bg); border-top: 1px solid var(--color-border);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <a
        href="/videos"
        style="display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.75rem 2rem; background: var(--color-primary); color: #fff; text-decoration: none; border-radius: 14px; transition: background 0.2s;"
        onmouseover="this.style.background='#1e4d38'"
        onmouseout="this.style.background='var(--color-primary)'"
      >
        <div>
          <p style="font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; margin: 0 0 0.25rem; color: #fff;">
            Watch our programmes in action
          </p>
          <p style="font-size: 0.9375rem; color: rgba(255,255,255,0.75); margin: 0;">
            Videos from Indonesia, Tanzania, Senegal and more
          </p>
        </div>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.8)" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="flex-shrink: 0;"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding: 4rem 1.5rem; background: var(--color-surface); border-top: 1px solid var(--color-border); text-align: center;">
    <div style="max-width: 560px; margin: 0 auto;">
      <h2 style="font-family: var(--font-display); font-size: clamp(1.375rem, 2.5vw, 1.75rem); color: var(--color-text); margin: 0 0 0.75rem;">
        Contact us to bring environmental education to your community!
      </h2>
      <p style="font-size: 1rem; color: var(--color-text-muted); line-height: 1.65; margin: 0 0 2rem;">
        We localise and adapt our materials for each partner. Get in touch to find out how we can work together.
      </p>
      <a
        href="/partner-with-us"
        style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.75rem; background: var(--color-accent); color: var(--color-text); font-size: 1rem; font-weight: 700; text-decoration: none; border-radius: 10px;"
      >
        Partner With Us →
      </a>
    </div>
  </section>
</PageLayout>

<style>
  @media (max-width: 900px) {
    .lang-grid { grid-template-columns: repeat(3, 1fr) !important; }
  }
  @media (max-width: 600px) {
    .lang-grid { grid-template-columns: repeat(2, 1fr) !important; }
    .coloring-grid { grid-template-columns: 1fr !important; }
  }
</style>
