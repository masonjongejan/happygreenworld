---
import PageLayout from '../layouts/PageLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import ImpactBar from '../components/sections/ImpactBar.astro';
import ProgrammePreviews from '../components/sections/ProgrammePreviews.astro';
import PhotoStrip from '../components/sections/PhotoStrip.astro';
import MissionStatement from '../components/sections/MissionStatement.astro';
import PartnerCallout from '../components/sections/PartnerCallout.astro';
import DonateCallout from '../components/sections/DonateCallout.astro';
---

<PageLayout
  title="Happy Green World"
  description="Happy Green World Foundation creates localised environmental education materials for children aged 6–16 worldwide, covering waste, water, and energy — in partnership with schools and NGOs across 12+ countries."
>
  <HeroSection />
  <ImpactBar />
  <ProgrammePreviews />
  <PhotoStrip />
  <MissionStatement />
  <PartnerCallout />
  <DonateCallout />
</PageLayout>
