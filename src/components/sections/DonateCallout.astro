---
---

<section style="padding: 5rem 1.5rem; background: var(--color-bg);">
  <div
    data-animate="scale"
    style="
      max-width: 800px;
      margin: 0 auto;
      background: linear-gradient(135deg, rgba(82, 183, 136, 0.12) 0%, rgba(45, 106, 79, 0.08) 100%);
      border: 1px solid var(--color-border);
      border-radius: 20px;
      padding: 3rem;
      text-align: center;
    "
  >
    <!-- Heartbeat icon with ring effect -->
    <div style="position: relative; width: 56px; height: 56px; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center;">
      <div style="
        position: absolute;
        inset: 0;
        border-radius: 14px;
        background: rgba(45, 106, 79, 0.08);
        animation: pulseRing 2.4s ease-out infinite;
        transform-origin: center;
      " aria-hidden="true"></div>
      <div style="
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: rgba(45, 106, 79, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-primary);
        position: relative;
      ">
        <div class="anim-heartbeat">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </div>
      </div>
    </div>

    <h2 style="
      font-family: var(--font-display);
      font-size: clamp(1.625rem, 3vw, 2rem);
      color: var(--color-text);
      margin: 0 0 0.875rem;
    ">
      Support environmental education worldwide
    </h2>
    <p style="
      font-size: 1.0625rem;
      color: var(--color-text-muted);
      line-height: 1.7;
      margin: 0 0 2rem;
      max-width: 520px;
      margin-left: auto;
      margin-right: auto;
    ">
      Every donation helps us localise our educational materials for a new school, a new community, or a new country. Your support brings one more classroom closer to a Happy Green World.
    </p>

    <a
      href="/donate"
      class="donate-btn"
      style="
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 2rem;
        background: var(--color-primary);
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        border-radius: 10px;
        transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
      "
    >
      Make a Donation
    </a>
  </div>
</section>

<style>
  .donate-btn:hover {
    background: #1e4d38 !important;
    transform: translateY(-3px) !important;
    box-shadow: 0 10px 28px rgba(45, 106, 79, 0.3) !important;
  }
</style>
