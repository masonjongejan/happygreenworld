---
---

<section style="
  padding: 4.5rem 1.5rem;
  background: var(--color-surface);
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
">
  <div style="max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: center;" class="callout-grid">
    <div data-animate="left">
      <span style="
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: rgba(244, 162, 97, 0.15);
        color: #b06a1a;
        font-size: 0.8125rem;
        font-weight: 600;
        border-radius: 99px;
        margin-bottom: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      ">
        For Organisations
      </span>
      <h2 style="
        font-family: var(--font-display);
        font-size: clamp(1.5rem, 3vw, 2rem);
        color: var(--color-text);
        margin: 0 0 0.75rem;
        line-height: 1.2;
      ">
        Ready to bring Happy Green World to your community?
      </h2>
      <p style="font-size: 1rem; color: var(--color-text-muted); line-height: 1.65; margin: 0;">
        We partner with schools, NGOs, foundations, and corporate sponsors worldwide to localise and deliver our environmental curriculum. Start with a simple conversation.
      </p>
    </div>
    <div data-animate="right" style="flex-shrink: 0;" class="callout-cta">
      <a
        href="/partner-with-us"
        class="partner-btn"
        style="
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          padding: 0.875rem 1.75rem;
          background: var(--color-accent);
          color: var(--color-text);
          font-size: 1rem;
          font-weight: 700;
          text-decoration: none;
          border-radius: 10px;
          white-space: nowrap;
          transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
        "
      >
        Partner With Us
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" class="partner-arrow" style="transition: transform 0.2s ease;">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12,5 19,12 12,19"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  @media (max-width: 700px) {
    .callout-grid { grid-template-columns: 1fr !important; gap: 1.5rem !important; }
    .callout-cta a { width: 100%; justify-content: center; }
  }

  .partner-btn:hover {
    background: #e8914a !important;
    transform: translateY(-3px) !important;
    box-shadow: 0 10px 28px rgba(244, 162, 97, 0.35) !important;
  }

  .partner-btn:hover .partner-arrow {
    transform: translateX(5px);
  }
</style>
