---
const photos = [
  { src: '/images/country-tanzania-children.jpg', alt: 'Children learning in Tanzania' },
  { src: '/images/about-indonesia-reading.jpg', alt: 'Students reading HGW materials in Indonesia' },
  { src: '/images/about-girl-waste-game.png', alt: 'A child playing the HGW waste sorting game' },
  { src: '/images/country-thailand-programme.jpg', alt: 'Happy Green World programme in Thailand' },
  { src: '/images/about-cameroon.jpg', alt: 'Happy Green World activities in Cameroon' },
  { src: '/images/about-australia.jpg', alt: 'Happy Green World activities in Australia' },
  { src: '/images/about-perth.jpg', alt: 'Happy Green World team in Perth' },
];
---

<section style="padding: 1.5rem 0; background: var(--color-bg); overflow: hidden;" aria-hidden="true">
  <!-- Infinite marquee: photos duplicated for seamless loop -->
  <div style="overflow: hidden;">
    <div class="marquee-track">
      {/* Original set */}
      {photos.map(({ src, alt }) => (
        <div style="
          flex-shrink: 0;
          width: 260px;
          height: 180px;
          border-radius: 14px;
          overflow: hidden;
          background: var(--color-border);
          margin-right: 0.75rem;
          transition: transform 0.3s ease, box-shadow 0.3s ease;
        " class="strip-photo">
          <img
            src={src}
            alt={alt}
            style="width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease;"
            loading="lazy"
          />
        </div>
      ))}
      {/* Duplicate for seamless loop */}
      {photos.map(({ src, alt }) => (
        <div style="
          flex-shrink: 0;
          width: 260px;
          height: 180px;
          border-radius: 14px;
          overflow: hidden;
          background: var(--color-border);
          margin-right: 0.75rem;
          transition: transform 0.3s ease;
        " class="strip-photo">
          <img
            src={src}
            alt={alt}
            style="width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease;"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .strip-photo:hover {
    transform: scale(1.04);
    box-shadow: 0 8px 24px rgba(45, 106, 79, 0.15);
    z-index: 1;
    position: relative;
  }

  .strip-photo:hover img {
    transform: scale(1.06);
  }
</style>
