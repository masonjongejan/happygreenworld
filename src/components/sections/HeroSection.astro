---
---

<section style="
  background: var(--color-bg);
  padding: 5rem 1.5rem;
  overflow: hidden;
">
  <div style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;" class="hero-grid">
    <!-- Left: text -->
    <div>
      <div class="hero-badge" style="
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.375rem 0.875rem;
        background: rgba(45, 106, 79, 0.1);
        border-radius: 99px;
        margin-bottom: 1.5rem;
        position: relative;
      ">
        <!-- Pulsing dot with ring -->
        <span style="position: relative; width: 8px; height: 8px; display: inline-flex; align-items: center; justify-content: center;">
          <span style="
            position: absolute;
            width: 8px; height: 8px;
            border-radius: 50%;
            background: var(--color-secondary);
            animation: pulseRing 2s ease-out infinite;
            opacity: 0.5;
          "></span>
          <span class="anim-pulse-dot" style="
            width: 8px; height: 8px;
            border-radius: 50%;
            background: var(--color-secondary);
            display: inline-block;
            position: relative;
          "></span>
        </span>
        <span style="font-size: 0.875rem; font-weight: 600; color: var(--color-primary);">Environmental Education Worldwide</span>
      </div>

      <h1 class="hero-h1" style="
        font-family: var(--font-display);
        font-size: clamp(2.25rem, 5vw, 3.25rem);
        font-weight: 700;
        color: var(--color-text);
        line-height: 1.12;
        margin: 0 0 1.25rem;
      ">
        Teaching children to care for their world
      </h1>

      <p class="hero-body" style="
        font-size: 1.1875rem;
        color: var(--color-text-muted);
        line-height: 1.7;
        margin: 0 0 2rem;
        max-width: 480px;
      ">
        Happy Green World Foundation creates localised environmental education materials for children aged 6–16. We work with schools, NGOs, and local partners in 12+ countries to teach waste, water, and energy literacy — one classroom at a time.
      </p>

      <div class="hero-ctas" style="display: flex; gap: 0.875rem; flex-wrap: wrap;">
        <a
          href="/programmes"
          style="
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.875rem 1.75rem;
            background: var(--color-primary);
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            border-radius: 10px;
            transition: background 0.2s, transform 0.2s;
          "
          onmouseover="this.style.background='#1e4d38'; this.style.transform='translateY(-2px)'"
          onmouseout="this.style.background='var(--color-primary)'; this.style.transform=''"
        >
          See Our Programmes
        </a>
        <a
          href="/partner-with-us"
          style="
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.875rem 1.75rem;
            background: transparent;
            color: var(--color-primary);
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            border-radius: 10px;
            border: 2px solid var(--color-primary);
            transition: background 0.2s, transform 0.2s;
          "
          onmouseover="this.style.background='rgba(45,106,79,0.07)'; this.style.transform='translateY(-2px)'"
          onmouseout="this.style.background='transparent'; this.style.transform=''"
        >
          Partner With Us
        </a>
      </div>
    </div>

    <!-- Right: floating image -->
    <div class="hero-image" style="position: relative;">
      <!-- Floating decorative leaf shapes behind the image -->
      <div style="
        position: absolute;
        top: -24px; right: -24px;
        width: 120px; height: 120px;
        border-radius: 50%;
        background: rgba(82, 183, 136, 0.12);
        animation: floatSlow 7s ease-in-out infinite;
        pointer-events: none;
      " aria-hidden="true"></div>
      <div style="
        position: absolute;
        bottom: -20px; left: -20px;
        width: 80px; height: 80px;
        border-radius: 50%;
        background: rgba(244, 162, 97, 0.1);
        animation: floatSlow 9s ease-in-out infinite 1.5s;
        pointer-events: none;
      " aria-hidden="true"></div>

      <!-- Main image with float -->
      <div class="anim-float" style="
        border-radius: 20px;
        overflow: hidden;
        aspect-ratio: 4/3;
        background: linear-gradient(135deg, #52B788 0%, #2D6A4F 100%);
        position: relative;
        z-index: 1;
      " class="hero-image-wrapper">
        <img
          src="/images/booklet-hero-tanzania-reading.png"
          alt="Two children reading a Happy Green World student book together in Tanzania"
          style="
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
          "
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr !important;
      gap: 2.5rem !important;
    }
    .hero-image-wrapper {
      aspect-ratio: 16/9 !important;
    }
  }
</style>
