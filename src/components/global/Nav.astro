---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/programmes', label: 'Programmes' },
  { href: '/our-projects', label: 'Our Partners' },
  { href: '/videos', label: 'Videos' },
  { href: '/resources', label: 'Resources' },
  { href: '/partner-with-us', label: 'Partner With Us' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header style="background: var(--color-surface); border-bottom: 1px solid var(--color-border);">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
    <nav style="display: flex; align-items: center; justify-content: space-between; height: 72px;" aria-label="Main navigation">
      <!-- Logo -->
      <a
        href="/"
        style="display: flex; align-items: center; gap: 0.625rem; text-decoration: none;"
        aria-label="Happy Green World — home"
      >
        <img
          src="/images/logo-happy-green-world.jpg"
          alt=""
          width="40"
          height="40"
          style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; flex-shrink: 0;"
        />
        <span style="font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; color: var(--color-primary); line-height: 1;">
          Happy Green World
        </span>
      </a>

      <!-- Desktop nav links -->
      <ul
        style="display: flex; align-items: center; gap: 0.25rem; list-style: none; margin: 0; padding: 0;"
        class="desktop-nav"
      >
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="nav-link"
              style={`
                display: inline-block;
                padding: 0.5rem 0.875rem;
                font-size: 0.9375rem;
                font-weight: 500;
                text-decoration: none;
                border-radius: 8px;
                transition: background 0.2s, color 0.2s, transform 0.2s;
                color: ${isActive(href) ? 'var(--color-primary)' : 'var(--color-text)'};
                background: ${isActive(href) ? 'rgba(45, 106, 79, 0.08)' : 'transparent'};
              `}
            >
              {label}
            </a>
          </li>
        ))}
        <li style="margin-left: 0.5rem;">
          <a
            href="/donate"
            style="
              display: inline-block;
              padding: 0.5rem 1.25rem;
              font-size: 0.9375rem;
              font-weight: 600;
              text-decoration: none;
              border-radius: 8px;
              background: var(--color-primary);
              color: #fff;
              transition: background 0.15s;
            "
          >
            Donate
          </a>
        </li>
      </ul>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        style="
          display: none;
          align-items: center;
          justify-content: center;
          width: 44px;
          height: 44px;
          border: none;
          background: transparent;
          cursor: pointer;
          border-radius: 8px;
          color: var(--color-text);
        "
        class="mobile-menu-btn"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    hidden
    style="
      border-top: 1px solid var(--color-border);
      background: var(--color-surface);
      padding: 1rem 1.5rem 1.5rem;
    "
  >
    <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.25rem;">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            style={`
              display: block;
              padding: 0.75rem 1rem;
              font-size: 1rem;
              font-weight: 500;
              text-decoration: none;
              border-radius: 8px;
              color: ${isActive(href) ? 'var(--color-primary)' : 'var(--color-text)'};
              background: ${isActive(href) ? 'rgba(45, 106, 79, 0.08)' : 'transparent'};
            `}
          >
            {label}
          </a>
        </li>
      ))}
      <li style="margin-top: 0.5rem;">
        <a
          href="/donate"
          style="
            display: block;
            padding: 0.875rem 1rem;
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            border-radius: 8px;
            background: var(--color-primary);
            color: #fff;
            text-align: center;
          "
        >
          Donate
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  @media (max-width: 768px) {
    .desktop-nav { display: none !important; }
    .mobile-menu-btn { display: flex !important; }
  }

  .nav-link:hover {
    background: rgba(45, 106, 79, 0.07) !important;
    color: var(--color-primary) !important;
    transform: translateY(-1px);
  }

  header {
    transition: box-shadow 0.3s ease;
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.hidden;
    if (menu) menu.hidden = isOpen;
    btn.setAttribute('aria-expanded', String(!isOpen));
    btn.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
  });
</script>
