---
const year = new Date().getFullYear();
---

<footer style="background: var(--color-primary); color: #fff; padding: 4rem 1.5rem 2rem;">
  <div style="max-width: 1200px; margin: 0 auto;">
    <!-- Top section -->
    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 3rem; margin-bottom: 3rem;" class="footer-grid">
      <!-- Brand column -->
      <div>
        <a href="/" style="display: flex; align-items: center; gap: 0.625rem; text-decoration: none; margin-bottom: 1rem;">
          <img
            src="/images/logo-happy-green-world.jpg"
            alt=""
            width="36"
            height="36"
            style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover; flex-shrink: 0; opacity: 0.92;"
          />
          <span style="font-family: var(--font-display); font-weight: 700; font-size: 1.0625rem; color: #fff;">
            Happy Green World
          </span>
        </a>
        <p style="font-size: 0.9375rem; color: rgba(255,255,255,0.75); line-height: 1.65; margin: 0 0 0.5rem;">
          Environmental education for children aged 6–16, delivered through local partners worldwide.
        </p>
        <p style="font-size: 0.875rem; color: rgba(255,255,255,0.55); line-height: 1.5; margin: 0; font-style: italic;">
          Globally Customised Programmes on Waste, Water and Energy.
        </p>
        <!-- Social links -->
        <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
          <a
            href="https://www.facebook.com/happygreenworld"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Happy Green World on Facebook"
            style="
              display: flex; align-items: center; justify-content: center;
              width: 40px; height: 40px; border-radius: 8px;
              background: rgba(255,255,255,0.12);
              color: #fff; text-decoration: none;
              transition: background 0.15s;
            "
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/happygreenworldorg/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Happy Green World on Instagram"
            style="
              display: flex; align-items: center; justify-content: center;
              width: 40px; height: 40px; border-radius: 8px;
              background: rgba(255,255,255,0.12);
              color: #fff; text-decoration: none;
              transition: background 0.15s;
            "
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href="mailto:info@happygreenworld.org"
            aria-label="Email Happy Green World"
            style="
              display: flex; align-items: center; justify-content: center;
              width: 40px; height: 40px; border-radius: 8px;
              background: rgba(255,255,255,0.12);
              color: #fff; text-decoration: none;
              transition: background 0.15s;
            "
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- About column -->
      <div>
        <h3 style="font-family: var(--font-body); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(255,255,255,0.5); margin: 0 0 1rem;">
          Organisation
        </h3>
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
          {[
            { href: '/about', label: 'About Us' },
            { href: '/programmes', label: 'Our Programmes' },
            { href: '/partner-with-us', label: 'Partner With Us' },
            { href: '/donate', label: 'Donate' },
          ].map(({ href, label }) => (
            <li>
              <a
                href={href}
                style="font-size: 0.9375rem; color: rgba(255,255,255,0.8); text-decoration: none;"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources column -->
      <div>
        <h3 style="font-family: var(--font-body); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(255,255,255,0.5); margin: 0 0 1rem;">
          Resources
        </h3>
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
          {[
            { href: '/resources', label: 'Educational Materials' },
            { href: '/videos', label: 'Videos' },
            { href: '/contact', label: 'Contact Us' },
          ].map(({ href, label }) => (
            <li>
              <a
                href={href}
                style="font-size: 0.9375rem; color: rgba(255,255,255,0.8); text-decoration: none;"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>

        <div style="margin-top: 1.5rem; padding: 1rem; background: rgba(255,255,255,0.08); border-radius: 10px;">
          <p style="font-size: 0.875rem; color: rgba(255,255,255,0.75); margin: 0 0 0.5rem; line-height: 1.5;">
            Want to bring HGW to your community?
          </p>
          <a
            href="/partner-with-us"
            style="font-size: 0.875rem; font-weight: 600; color: var(--color-accent-light); text-decoration: underline; text-underline-offset: 3px;"
          >
            Start the conversation →
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div style="border-top: 1px solid rgba(255,255,255,0.15); padding-top: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;">
      <p style="font-size: 0.875rem; color: rgba(255,255,255,0.5); margin: 0;">
        © {year} Stichting Happy Green World. All rights reserved.
      </p>
      <p style="font-size: 0.875rem; color: rgba(255,255,255,0.5); margin: 0;">
        info@happygreenworld.org
      </p>
    </div>
  </div>
</footer>

<style>
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr !important;
      gap: 2rem !important;
    }
  }
</style>
